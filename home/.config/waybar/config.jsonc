// WAYBAR — graphite, trimmed
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin-top": 4,
    "margin-left": 6,
    "margin-right": 6,
    "spacing": 2,

    "modules-left": [
        "custom/logo",
        "hyprland/workspaces",
        "hyprland/submap",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "mpris",
        "tray",
        "cpu",
        "memory",
        "network",
        "backlight",
        "wireplumber",
        "battery",
        "custom/theme",
        "custom/wallpaper",
        "custom/power"
    ],

    "custom/logo": {
        "format": "❄",
        "tooltip": false,
        "on-click": "rofi -show drun"
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1",
        "all-outputs": false,
        "persistent-workspaces": {
            "DP-5": [1, 2, 3, 4, 5],
            "HDMI-A-5": [6, 7, 8, 9]
        }
    },

    "hyprland/submap": {
        "format": "󰌌 {}",
        "tooltip": false
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 44,
        "separate-outputs": true
    },

    "mpris": {
        "format": "󰝚 {dynamic}",
        "format-paused": "󰏤 {dynamic}",
        "dynamic-len": 30,
        "dynamic-order": ["title", "artist"],
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "tooltip-format": "{player}\n{title} — {artist}"
    },

    "clock": {
        "format": "{:%H:%M  %a %d %b}",
        "format-alt": "{:%H:%M:%S  %A, %d %B %Y}",
        "interval": 1,
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months":   "<b>{}</b>",
                "weekdays": "<span color='#8fa1b3'>{}</span>",
                "today":    "<span color='#8fa1b3'><b><u>{}</u></b></span>"
            }
        },
        "actions": { "on-click-right": "mode", "on-scroll-up": "shift_up", "on-scroll-down": "shift_down" }
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 2,
        "states": { "warning": 70, "critical": 90 },
        "on-click": "kitty -e btop"
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
        "states": { "warning": 70, "critical": 90 },
        "on-click": "kitty -e btop"
    },

    "network": {
        "format-wifi": "{icon} {signalStrength}%",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "interval": 3,
        "tooltip-format-wifi": "{essid}\n{ipaddr} · ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr} · ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
        "on-click": "nm-connection-editor"
    },

    "backlight": {
        "format": "󰃟 {percent}%",
        "on-scroll-up": "brightnessctl set 2%+",
        "on-scroll-down": "brightnessctl set 2%-"
    },

    "wireplumber": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰝟",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "wpctl set-volume -l 1.4 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "states": { "warning": 25, "critical": 10 },
        "tooltip-format": "{timeTo}"
    },

    "tray": {
        "icon-size": 15,
        "spacing": 8
    },

    "custom/theme": {
        "format": "󰏘",
        "tooltip-format": "switch theme",
        "on-click": "~/.local/bin/theme-switch"
    },

    "custom/wallpaper": {
        "format": "󰸉",
        "tooltip-format": "wallpaper picker (right-click: random)",
        "on-click": "~/.local/bin/wall",
        "on-click-right": "~/.local/bin/wall random"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "sh -c 'sel=$(printf \"lock\\nlogout\\nreboot\\nshutdown\" | rofi -dmenu -p power); case \"$sel\" in lock) hyprlock ;; logout) hyprctl dispatch exit ;; reboot) systemctl reboot ;; shutdown) systemctl poweroff ;; esac'"
    }
}
