/* grid.rasi — card-grid picker for themes & wallpapers (tabby rice) */
/* colors are injected at launch via rofi -theme-str, so no @import needed */

* {
    /* fallback defaults if theme-str somehow doesn't inject (dark, not light) */
    bg0:    #161616f2;
    bg1:    #1e1e1e;
    bg2:    #262626;
    fg0:    #d4d4d4;
    muted:  #6a6a6a;
    accent: #8fa1b3;
    red:    #bf8b8b;
    font: "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color: @fg0;
}

window {
    width:            60%;
    border-radius:    20px;
    background-color: @bg0;
    border:           2px;
    border-color:     @accent;
    padding:          0;
}

mainbox {
    padding:  24px;
    spacing:  18px;
    background-color: transparent;
    children: [ inputbar, listview ];
}

listview {
    columns:      4;
    lines:        2;
    spacing:      16px;
    cycle:        true;
    dynamic:      true;
    layout:       vertical;
    flow:         horizontal;
    fixed-height: false;
    background-color: transparent;
    border:       0;
}

inputbar {
    background-color: @bg1;
    border-radius:    14px;
    padding:          12px 16px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font:       "JetBrainsMono Nerd Font Bold 13";
    background-color: transparent;
}

entry {
    text-color:        @fg0;
    placeholder:       "type to filter…";
    placeholder-color: @muted;
    cursor:            text;
    background-color:  transparent;
}

element {
    orientation:   vertical;
    padding:       18px 10px;
    spacing:       12px;
    border-radius: 16px;
    background-color: @bg1;
    children:      [ element-icon, element-text ];
}

element-icon {
    size:             56px;
    horizontal-align: 0.5;
    background-color: transparent;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    text-color:       @fg0;
    background-color: transparent;
}

element normal.normal   { background-color: @bg1;    text-color: @fg0; }
element selected.normal  {
    background-color: @accent;
    text-color:       @bg0;
    border:           2px;
    border-color:     @accent;
}
element alternate.normal { background-color: @bg1;    text-color: @fg0; }
