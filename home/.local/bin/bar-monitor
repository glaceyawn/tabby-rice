#!/usr/bin/env bash
# bar-monitor — choose which monitor(s) waybar appears on
# usage: bar-monitor            (rofi menu)
#        bar-monitor all        (every monitor)
#        bar-monitor <NAME>     (only that output, e.g. DP-5)
set -u
CFG="$HOME/.config/waybar/config.jsonc"
command -v hyprctl >/dev/null || { notify-send -a theme "bar" "needs hyprland running"; exit 1; }
command -v python3  >/dev/null || { notify-send -a theme "bar" "needs python3"; exit 1; }

set_output() {  # $1 = json array contents, e.g. '' for all or '"DP-5"'
    python3 - "$CFG" "$1" << 'PY'
import sys, re
cfg, val = sys.argv[1], sys.argv[2]
s = open(cfg).read()
# replace the "output": [...] line (handles [] or ["x"] or ["x","y"])
if val.strip():
    if re.search(r'"output"\s*:\s*\[[^\]]*\]', s):
        s = re.sub(r'"output"\s*:\s*\[[^\]]*\]', '"output": [' + val + ']', s, count=1)
    else:
        # add output field after position
        s = re.sub(r'("position"\s*:\s*"[a-z]+",)', r'\1\n    "output": [' + val + '],', s, count=1)
else:
    # remove the field entirely -> waybar shows on all monitors
    s = re.sub(r'\s*"output"\s*:\s*\[[^\]]*\],?\n', '\n', s, count=1)
open(cfg, 'w').write(s)
PY
}

mapfile -t MONS < <(hyprctl monitors all -j | python3 -c 'import json,sys; [print(m["name"]) for m in json.load(sys.stdin)]')

case "${1:-}" in
    all) set_output ""; MSG="all monitors" ;;
    "")
        CHOICE="$(printf 'all monitors\n%s\n' "$(printf '%s\n' "${MONS[@]}")" | rofi -dmenu -p "󰍹 waybar on" -i)"
        [ -z "$CHOICE" ] && exit 0
        if [ "$CHOICE" = "all monitors" ]; then set_output ""; MSG="all monitors"
        else set_output "\"$CHOICE\""; MSG="$CHOICE only"; fi ;;
    *) set_output "\"$1\""; MSG="$1 only" ;;
esac

pkill waybar; waybar >/dev/null 2>&1 & disown
notify-send -a theme "bar" "waybar → $MSG"
