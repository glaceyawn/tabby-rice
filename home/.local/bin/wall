#!/usr/bin/env bash
# wall v2 — sectioned wallpaper picker
# usage: wall            (category menu → thumbnail grid)
#        wall random     (random from everything)
#        wall <theme>    (grid for that folder directly, e.g. `wall nord`)
#        wall /path/img  (set directly)
set -u
WPP="$(command -v awww || command -v swww)" || { notify-send "wallpaper" "awww/swww not installed"; exit 1; }
WPP_NAME="$(basename "$WPP")"          # awww or swww
DAEMON="${WPP_NAME}-daemon"           # awww-daemon / swww-daemon
WALLS="$HOME/Pictures/wallpapers"
TE="$HOME/.config/theme-engine"
CUR="$(cat "$TE/current" 2>/dev/null || echo graphite)"
TRANSITIONS=(grow wave outer wipe center any)
T="${TRANSITIONS[RANDOM % ${#TRANSITIONS[@]}]}"

# make sure the wallpaper daemon is actually running (it sometimes dies,
# which is what makes the wallpaper go blank and further swaps do nothing)
ensure_daemon() {
    if ! pgrep -x "$DAEMON" >/dev/null 2>&1; then
        # (re)start it detached and give it a moment to take the socket
        "$DAEMON" >/dev/null 2>&1 &
        disown 2>/dev/null || true
        sleep 0.6
    fi
}

# a safe cursor position for the transition origin — falls back to center
cursor_pos() {
    local p
    p="$(hyprctl cursorpos 2>/dev/null | tr -d ' ')"
    # must look like "1234,567"; otherwise don't pass a pos at all
    if printf '%s' "$p" | grep -qE '^[0-9]+,[0-9]+$'; then
        printf '%s' "$p"
    else
        printf 'center'
    fi
}

apply() {
    ensure_daemon
    local pos; pos="$(cursor_pos)"
    local posargs=()
    if [ "$pos" = "center" ]; then
        posargs=( --transition-type center )
    else
        posargs=( --transition-type "$T" --transition-pos "$pos" )
    fi
    # try the fancy transition; if the daemon errors, restart it and do a
    # plain set so the wallpaper never ends up blank
    if ! "$WPP" img "$1" \
            "${posargs[@]}" \
            --transition-duration 1.2 \
            --transition-fps 120 \
            --transition-bezier .09,.91,.52,1.05 2>/dev/null; then
        pkill -x "$DAEMON" 2>/dev/null || true
        sleep 0.3
        ensure_daemon
        "$WPP" img "$1" --transition-type none 2>/dev/null \
            || notify-send -a theme "wallpaper" "couldn't set wallpaper (daemon issue)"
    fi
    notify-send -a theme "wallpaper" "$(basename "$1") · $T"
}

list_imgs() {  # $1 = dir, $2 = depth
    find "$1" -maxdepth "${2:-1}" -type f \( -name '*.png' -o -name '*.jpg' -o -name '*.jpeg' -o -name '*.webp' \) 2>/dev/null | sort
}

grid() {  # $@ = files; thumbnail grid, applies choice
    local files=("$@")
    [ ${#files[@]} -eq 0 ] && { notify-send -a theme "wallpaper" "folder is empty — run wall-fetch?"; exit 1; }
    # load current theme palette so the picker matches the active theme
    local cur; cur="$(cat "$TE/current" 2>/dev/null || echo graphite)"
    local CBG=161616 CBG1=1e1e1e CBG2=262626 CFG=d4d4d4 CMUTED=6a6a6a CACCENT=8fa1b3 CRED=bf8b8b
    if [ -f "$TE/themes/$cur.sh" ]; then
        # shellcheck disable=SC1090
        . "$TE/themes/$cur.sh"
        CBG="$BG"; CBG1="$BG1"; CBG2="$BG2"; CFG="$FG"; CMUTED="$MUTED"; CACCENT="$ACCENT"; CRED="$RED"
    fi
    CHOICE="$(for f in "${files[@]}"; do
        bn="$(basename "$f")"
        # clean display name: strip extension, swap _/- for spaces
        disp="${bn%.*}"; disp="${disp//_/ }"; disp="${disp//-/ }"
        printf '%s\0icon\x1f%s\n' "$disp" "$f"
    done | rofi -dmenu -p "wallpaper" -i -show-icons \
                -theme "$HOME/.config/rofi/grid.rasi" \
                -theme-str "* { bg0: #${CBG}f2; bg1: #${CBG1}; bg2: #${CBG2}; fg0: #${CFG}; muted: #${CMUTED}; accent: #${CACCENT}; red: #${CRED}; } listview { columns: 3; lines: 2; } element-icon { size: 200px; } element-text { enabled: true; horizontal-align: 0.5; }")"
    [ -z "$CHOICE" ] && exit 0
    for f in "${files[@]}"; do
        bn="$(basename "$f")"; disp="${bn%.*}"; disp="${disp//_/ }"; disp="${disp//-/ }"
        [ "$disp" = "$CHOICE" ] && { apply "$f"; exit; }
    done
}

case "${1:-}" in
    random)
        mapfile -t ALL < <(list_imgs "$WALLS" 2)
        [ ${#ALL[@]} -eq 0 ] && { notify-send -a theme "wallpaper" "nothing in $WALLS"; exit 1; }
        apply "${ALL[RANDOM % ${#ALL[@]}]}"; exit ;;
    /*|~*) apply "$1"; exit ;;
    "") ;;
    *)  mapfile -t F < <(list_imgs "$WALLS/$1"); grid "${F[@]}"; exit ;;
esac

# ── category menu ──
MENU="󰋜  $CUR (current theme)\n󰇧  global\n"
for d in "$WALLS"/*/; do
    b="$(basename "$d")"
    case "$b" in "$CUR"|global) continue ;; esac
    MENU+="󰏘  $b\n"
done
MENU+="󰒺  everything\n󰒲  random"

SEL="$(printf '%b' "$MENU" | rofi -dmenu -p "󰸉 wallpapers" -i)"
[ -z "$SEL" ] && exit 0
SEL="$(echo "$SEL" | awk '{print $2}')"

case "$SEL" in
    random)      exec "$0" random ;;
    everything)  mapfile -t F < <(list_imgs "$WALLS" 2); grid "${F[@]}" ;;
    *)           mapfile -t F < <(list_imgs "$WALLS/$SEL"); grid "${F[@]}" ;;
esac
