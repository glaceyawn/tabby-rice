#!/usr/bin/env bash
# theme-switch — one command, every app re-themed
# usage: theme-switch            (rofi picker)
#        theme-switch <name>     (direct)
#        theme-switch --restore  (on login, reapply saved theme)
set -u
WPP="$(command -v awww || command -v swww)" || { notify-send "wallpaper" "awww/swww not installed"; exit 1; }
TE="$HOME/.config/theme-engine"
STATE="$TE/current"
WALLS="$HOME/Pictures/wallpapers"

pick() {
    # load the CURRENT theme's palette so the picker itself is themed
    local cur; cur="$(cat "$STATE" 2>/dev/null || echo graphite)"
    # shellcheck disable=SC1090
    [ -f "$TE/themes/$cur.sh" ] && . "$TE/themes/$cur.sh"
    # generate a small swatch preview per theme (cached), then show a card grid
    local cache="$TE/swatches"
    mkdir -p "$cache"
    local out=""
    for t in graphite mocha latte tokyonight rosepine gruvbox nord; do
        local sw="$cache/$t.png"
        if [ ! -f "$sw" ] && command -v convert >/dev/null 2>&1; then
            # shellcheck disable=SC1090
            ( . "$TE/themes/$t.sh"
              convert -size 120x120 xc:"#$BG" \
                -fill "#$ACCENT" -draw "roundrectangle 12,12 108,58 8,8" \
                -fill "#$GREEN"  -draw "roundrectangle 12,66 58,108 8,8" \
                -fill "#$RED"    -draw "roundrectangle 66,66 108,108 8,8" \
                "$sw" 2>/dev/null )
        fi
        # rofi dmenu icon format: text\0icon\x1f/path/to/icon
        if [ -f "$sw" ]; then
            out+="$t\0icon\x1f$sw\n"
        else
            out+="$t\n"
        fi
    done
    printf "%b" "$out" \
        | rofi -dmenu -p "theme" -i \
               -theme "$HOME/.config/rofi/grid.rasi" \
               -theme-str "* { bg0: #${BG}f2; bg1: #${BG1}; bg2: #${BG2}; fg0: #${FG}; muted: #${MUTED}; accent: #${ACCENT}; red: #${RED}; }" \
               -show-icons
}

case "${1:-}" in
    --restore) THEME="$(cat "$STATE" 2>/dev/null || echo graphite)" ;;
    "")        THEME="$(pick)"; [ -z "${THEME:-}" ] && exit 0 ;;
    *)         THEME="$1" ;;
esac

SRC="$TE/themes/$THEME.sh"
[ -f "$SRC" ] || { notify-send -a theme "theme" "no such theme: $THEME"; exit 1; }
. "$SRC"

# ── hyprland ────────────────────────────────
cat > "$HOME/.config/hypr/colors.conf" << EOF
\$bg     = rgba(${BG}ff)
\$bg1    = rgba(${BG1}ff)
\$bg2    = rgba(${BG2}ff)
\$fg     = rgba(${FG}ff)
\$muted  = rgba(${MUTED}ff)
\$accent = rgba(${ACCENT}ff)
\$red    = rgba(${RED}ff)
EOF

# ── hyprlock (needs bare hex for pango spans too) ──
cat > "$HOME/.config/hypr/hyprlock-colors.conf" << EOF
\$bg     = rgba(${BG}ff)
\$bg1    = rgba(${BG1}ff)
\$fg     = rgba(${FG}ff)
\$muted  = rgba(${MUTED}ff)
\$accent = rgba(${ACCENT}ff)
\$green  = rgba(${GREEN}ff)
\$red    = rgba(${RED}ff)
\$yellow = rgba(${YELLOW}ff)
\$MUTEDHEX = ${MUTED}
\$REDHEX = ${RED}
EOF

# ── waybar ──────────────────────────────────
cat > "$HOME/.config/waybar/colors.css" << EOF
@define-color bg      #${BG};
@define-color bg1     #${BG1};
@define-color bg2     #${BG2};
@define-color fg      #${FG};
@define-color muted   #${MUTED};
@define-color accent  #${ACCENT};
@define-color red     #${RED};
@define-color green   #${GREEN};
@define-color yellow  #${YELLOW};
@define-color blue    #${BLUE};
@define-color magenta #${MAGENTA};
@define-color cyan    #${CYAN};
EOF

# ── kitty ───────────────────────────────────
cat > "$HOME/.config/kitty/colors.conf" << EOF
foreground #${FG}
background #${BG}
selection_foreground #${BG}
selection_background #${ACCENT}
cursor #${FG}
cursor_text_color #${BG}
url_color #${ACCENT}
active_border_color #${ACCENT}
inactive_border_color #${BG2}
active_tab_background #${ACCENT}
active_tab_foreground #${BG}
inactive_tab_background #${BG1}
inactive_tab_foreground #${MUTED}
tab_bar_background #${BG}
visual_bell_color #${BG2}
color0  #${BG2}
color8  #${MUTED}
color1  #${RED}
color9  #${RED}
color2  #${GREEN}
color10 #${GREEN}
color3  #${YELLOW}
color11 #${YELLOW}
color4  #${BLUE}
color12 #${BLUE}
color5  #${MAGENTA}
color13 #${MAGENTA}
color6  #${CYAN}
color14 #${CYAN}
color7  #${FG}
color15 #${FG}
EOF
# live-reload every running kitty instance
for sock in /tmp/kitty-*; do
    [ -S "$sock" ] && kitty @ --to "unix:$sock" set-colors --all "$HOME/.config/kitty/colors.conf" 2>/dev/null
done

# ── rofi ────────────────────────────────────
cat > "$HOME/.config/rofi/colors.rasi" << EOF
* {
    bg0:    #${BG}f2;
    bg1:    #${BG1};
    bg2:    #${BG2};
    fg0:    #${FG};
    muted:  #${MUTED};
    accent: #${ACCENT};
    red:    #${RED};
}
EOF

# ── mako (render template) ──────────────────
sed -e "s/{{BG}}/$BG/g"   -e "s/{{BG1}}/$BG1/g" -e "s/{{BG2}}/$BG2/g" \
    -e "s/{{FG}}/$FG/g"   -e "s/{{MUTED}}/$MUTED/g" \
    -e "s/{{ACCENT}}/$ACCENT/g" -e "s/{{RED}}/$RED/g" \
    "$TE/templates/mako.tpl" > "$HOME/.config/mako/config"

# ── starship (flip palette) ─────────────────
sed -i "s/^palette = .*/palette = \"$THEME\"/" "$HOME/.config/starship.toml"

# ── per-theme wallpaper, if a folder exists ─
if command -v "$WPP" >/dev/null && [ -d "$WALLS/$THEME" ]; then
    W="$(find "$WALLS/$THEME" -type f \( -name '*.png' -o -name '*.jpg' -o -name '*.jpeg' -o -name '*.webp' \) | shuf -n1)"
    [ -n "$W" ] && "$WPP" img "$W" --transition-type grow --transition-pos center --transition-duration 1.2 --transition-fps 180
fi

# ── qt6ct color scheme (themes all Qt apps) ─
mkdir -p "$HOME/.config/qt6ct/colors"
cat > "$HOME/.config/qt6ct/colors/tabby-dark.conf" << EOF
[ColorScheme]
active_colors=#ff${FG}, #ff${BG1}, #ff${BG2}, #ff${BG1}, #ff${BG}, #ff${BG1}, #ff${FG}, #ffffffff, #ff${FG}, #ff${BG}, #ff${BG}, #ff${BG}, #ff${ACCENT}, #ff${BG}, #ff${ACCENT}, #ff${RED}, #ff${BG1}, #ff000000, #ff${BG1}, #ff${FG}, #80808080
disabled_colors=#ff${MUTED}, #ff${BG1}, #ff${BG2}, #ff${BG1}, #ff${BG}, #ff${BG1}, #ff${MUTED}, #ffffffff, #ff${MUTED}, #ff${BG}, #ff${BG}, #ff${BG}, #ff${MUTED}, #ff${MUTED}, #ff${ACCENT}, #ff${RED}, #ff${BG1}, #ff000000, #ff${BG1}, #ff${MUTED}, #80808080
inactive_colors=#ff${FG}, #ff${BG1}, #ff${BG2}, #ff${BG1}, #ff${BG}, #ff${BG1}, #ff${FG}, #ffffffff, #ff${FG}, #ff${BG}, #ff${BG}, #ff${BG}, #ff${ACCENT}, #ff${BG}, #ff${ACCENT}, #ff${RED}, #ff${BG1}, #ff000000, #ff${BG1}, #ff${FG}, #80808080
EOF
# kdeglobals — full color scheme for Qt/KDE apps. hex→"r,g,b".
h2r() { printf '%d,%d,%d' "0x${1:0:2}" "0x${1:2:2}" "0x${1:4:2}"; }
cat > "$HOME/.config/kdeglobals" << EOF
[General]
ColorScheme=tabby-dark
Name=tabby-dark

[Icons]
Theme=Papirus-Dark

[KDE]
SingleClick=false

[Colors:View]
BackgroundNormal=$(h2r "$BG1")
BackgroundAlternate=$(h2r "$BG2")
ForegroundNormal=$(h2r "$FG")
ForegroundInactive=$(h2r "$MUTED")
DecorationFocus=$(h2r "$ACCENT")
DecorationHover=$(h2r "$ACCENT")

[Colors:Window]
BackgroundNormal=$(h2r "$BG")
BackgroundAlternate=$(h2r "$BG1")
ForegroundNormal=$(h2r "$FG")
ForegroundInactive=$(h2r "$MUTED")
DecorationFocus=$(h2r "$ACCENT")

[Colors:Selection]
BackgroundNormal=$(h2r "$ACCENT")
ForegroundNormal=$(h2r "$BG")

[Colors:Button]
BackgroundNormal=$(h2r "$BG2")
ForegroundNormal=$(h2r "$FG")
DecorationFocus=$(h2r "$ACCENT")

[Colors:Tooltip]
BackgroundNormal=$(h2r "$BG1")
ForegroundNormal=$(h2r "$FG")
EOF

# ── PCManFM-Qt (file manager) ───────────────
# it reads the qt6ct palette above for its view, but also has its own
# settings for the icon theme + view. regenerate so it matches the theme.
mkdir -p "$HOME/.config/pcmanfm-qt/default"
cat > "$HOME/.config/pcmanfm-qt/default/settings.conf" << EOF
[Behavior]
SingleClick=false
ConfirmDelete=true

[Desktop]
WallpaperMode=0

[FolderView]
Mode=1
ShowHidden=false

[System]
FallbackIconThemeName=Papirus-Dark
Terminal=kitty
Archiver=

[Window]
AlwaysShowTabs=false
PathBarButtons=true
EOF

# folder icon accent: papirus-folders can't touch the system icon dir without
# sudo (bad for a per-switch script), so we keep a USER copy of Papirus-Dark
# in ~/.local/share/icons and recolor that — no password prompts.
if command -v papirus-folders >/dev/null 2>&1; then
    USERICONS="$HOME/.local/share/icons"
    if [ ! -d "$USERICONS/Papirus-Dark" ] && [ -d /usr/share/icons/Papirus-Dark ]; then
        mkdir -p "$USERICONS"
        cp -r /usr/share/icons/Papirus-Dark "$USERICONS/" 2>/dev/null
        cp -r /usr/share/icons/Papirus "$USERICONS/" 2>/dev/null  # base it inherits from
    fi
    # map each theme to its closest papirus folder color (matches the accent)
    case "$THEME" in
        graphite)   PF=bluegrey ;;
        mocha)      PF=violet ;;
        latte)      PF=violet ;;
        tokyonight) PF=blue ;;
        rosepine)   PF=violet ;;
        gruvbox)    PF=orange ;;
        nord)       PF=cyan ;;
        *)          PF=bluegrey ;;
    esac
    # recolor the USER copy (no sudo needed since it's in $HOME)
    papirus-folders -C "$PF" --theme Papirus-Dark >/dev/null 2>&1
    # refresh the icon cache so apps pick it up
    command -v gtk-update-icon-cache >/dev/null 2>&1 && \
        gtk-update-icon-cache -f "$USERICONS/Papirus-Dark" >/dev/null 2>&1 || true
fi

# ── wlogout (power menu) ────────────────────
mkdir -p "$HOME/.config/wlogout/icons"
cat > "$HOME/.config/wlogout/wlogout-colors.css" << EOF
@define-color bg      #${BG};
@define-color bg1     #${BG1};
@define-color bg2     #${BG2};
@define-color fg      #${FG};
@define-color accent  #${ACCENT};
EOF
# recolor the icon SVG strokes AND fills (keyhole dot) to the theme foreground
if [ -d "$HOME/.config/wlogout/icons" ]; then
    for svg in "$HOME/.config/wlogout/icons/"*.svg; do
        [ -f "$svg" ] || continue
        sed -i "s|stroke=\"#[0-9a-fA-F]*\"|stroke=\"#${FG}\"|g" "$svg" 2>/dev/null
        # recolor solid fills but never fill="none"
        sed -i "s|fill=\"#[0-9a-fA-F]*\"|fill=\"#${FG}\"|g" "$svg" 2>/dev/null
    done
fi

# ── reload the world ────────────────────────
echo "$THEME" > "$STATE"
hyprctl reload >/dev/null 2>&1
makoctl reload >/dev/null 2>&1
pkill waybar; waybar >/dev/null 2>&1 & disown
notify-send -a theme "theme" "switched to $THEME"
